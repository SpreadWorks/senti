{
  "name": "workflow",
  "type": "workflow",
  "description": "Workflow command and flow hook plugin",
  "verification": {
    "command": "commands/workflow.js",
    "prepareHook": "hooks/prepare.js",
    "finalizeCleanupHook": "hooks/finalize-cleanup.js"
  },
  "files": [
    "plugin.json",
    "commands/",
    "hooks/",
    "skills/",
    "lib/",
    "config.schema.json",
    "config.defaults.json"
  ],
  "contributions": {
    "commands": [
      {
        "name": "workflow",
        "path": "commands/workflow.js",
        "desc": "[EXPERIMENTAL] Manage workflow board drafts",
        "section": "Plugins",
        "experimental": true,
        "help": "Usage: senti workflow <subcommand> [args]"
      }
    ],
    "skills": [
      { "name": "senti.workflow", "path": "skills/senti.workflow" }
    ],
    "config": {
      "schema": "config.schema.json",
      "defaults": "config.defaults.json"
    },
    "hooks": [
      { "path": "hooks/prepare.js" },
      { "path": "hooks/finalize-cleanup.js" }
    ]
  }
}
