{
  "type": "object",
  "required": [
    "version",
    "repairFingerprint",
    "mechanicalBlockers",
    "hardBlockers",
    "requirementJudgments",
    "deferredFindings",
    "userDecision",
    "verdict"
  ],
  "additionalProperties": true,
  "properties": {
    "version": { "type": "integer", "enum": [2] },
    "repairFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "mechanicalBlockers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["blockerId", "kind", "summary"],
        "additionalProperties": false,
        "properties": {
          "blockerId": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 }
        }
      }
    },
    "hardBlockers": { "type": "array", "items": { "type": "object" } },
    "requirementJudgments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "requirementId",
          "status",
          "requestRefs",
          "requirementRefs",
          "diffRefs",
          "repairRefs",
          "testRefs",
          "missingEvidence"
        ],
        "additionalProperties": false,
        "properties": {
          "requirementId": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["met", "notMet", "notVerifiable"] },
          "requestRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "requirementRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "diffRefs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "repairRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "testRefs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "missingEvidence": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "deferredFindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "findingId",
          "sourceStep",
          "sourceArtifact",
          "sourceFindingId",
          "finalDisposition",
          "evidenceRefs"
        ],
        "additionalProperties": false,
        "properties": {
          "findingId": { "type": "string", "minLength": 1 },
          "sourceStep": { "type": "string", "minLength": 1 },
          "sourceArtifact": { "type": "string", "minLength": 1 },
          "sourceFindingId": { "type": "string", "minLength": 1 },
          "finalDisposition": { "type": "string", "minLength": 1 },
          "evidenceRefs": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "userDecision": {
      "oneOf": [
        {
          "type": "object",
          "required": ["choice", "decidedAt"],
          "additionalProperties": false,
          "properties": {
            "choice": { "type": "string", "enum": ["accept_risk_and_continue", "abort"] },
            "decidedAt": { "type": "string", "minLength": 1 }
          }
        },
        { "type": "null" }
      ]
    },
    "verdict": {
      "type": "string",
      "enum": ["pass", "repair_required", "user_decision_required", "blocked"]
    },
    "reportRefs": { "type": "array", "items": { "type": "string" } }
  }
}
