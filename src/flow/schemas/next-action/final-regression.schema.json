{
  "type": "object",
  "required": ["completed", "result_path", "raw_output_path", "result", "failureKind"],
  "properties": {
    "completed": { "type": "boolean" },
    "result_path": { "type": "string" },
    "raw_output_path": { "type": "string" },
    "result": { "type": "string", "enum": ["pass", "fail", "skipped"] },
    "skipKind": {
      "type": "string",
      "enum": [
        "covered_by_test_execute_full_regression",
        "risk_based_static_proof",
        "skipped_by_project_policy"
      ]
    },
    "failureKind": {
      "type": ["string", "null"],
      "enum": [
        "caused_by_current_change",
        "unattributed_existing_failure",
        "infra_failure",
        "timeout",
        "dependency_failure",
        "sandbox_restriction",
        "permission_error",
        "child_process_eperm",
        "invalid_project_test",
        null
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "result": { "const": "pass" } },
        "required": ["result"]
      },
      "then": {
        "properties": {
          "failureKind": { "const": null }
        }
      }
    },
    {
      "if": {
        "properties": { "result": { "const": "skipped" } },
        "required": ["result"]
      },
      "then": {
        "required": ["skipKind"],
        "properties": {
          "failureKind": { "const": null }
        }
      }
    },
    {
      "if": {
        "properties": { "result": { "const": "fail" } },
        "required": ["result"]
      },
      "then": {
        "properties": {
          "failureKind": {
            "type": "string",
            "enum": [
              "caused_by_current_change",
              "unattributed_existing_failure",
              "infra_failure",
              "timeout",
              "dependency_failure",
              "sandbox_restriction",
              "permission_error",
              "child_process_eperm",
              "invalid_project_test"
            ]
          }
        }
      }
    }
  ]
}
