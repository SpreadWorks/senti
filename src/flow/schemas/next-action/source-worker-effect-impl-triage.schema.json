{
  "type": "object",
  "required": ["version", "stepId", "completionStatus", "files", "issues", "overview", "triage", "repair", "noChangeReason"],
  "properties": {
    "version": { "type": "integer", "enum": [1] },
    "stepId": { "type": "string", "enum": ["impl-triage"] },
    "completionStatus": { "type": "string", "enum": ["done"] },
    "files": { "type": "array", "maxItems": 0, "items": { "type": "object", "required": ["requirementId", "mutationIds"], "properties": { "requirementId": { "type": "string", "minLength": 1 }, "mutationIds": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } }, "additionalProperties": false } },
    "issues": { "type": "array", "maxItems": 0, "items": { "type": "object", "required": ["reason", "trigger", "resolution"], "properties": { "reason": { "type": "string", "minLength": 20 }, "trigger": { "type": ["string", "null"], "minLength": 10 }, "resolution": { "type": ["string", "null"], "minLength": 10 } }, "additionalProperties": false } },
    "overview": { "type": "null" },
    "triage": { "type": "object", "required": ["version", "dispositions"], "properties": { "version": { "type": "integer", "enum": [1] }, "dispositions": { "type": "array", "maxItems": 256, "items": { "type": "object", "required": ["findingKey", "disposition", "rationale"], "properties": { "findingKey": { "type": "string", "minLength": 1 }, "disposition": { "type": "string", "enum": ["apply", "reject"] }, "rationale": { "type": "string", "minLength": 10 } }, "additionalProperties": false } } }, "additionalProperties": false },
    "repair": { "type": "null" },
    "noChangeReason": { "type": "null" }
  },
  "additionalProperties": false
}
