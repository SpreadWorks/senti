{
  "type": "object",
  "required": ["version", "stepId", "completionStatus", "files", "issues", "overview", "triage", "repair", "noChangeReason"],
  "properties": {
    "version": { "type": "integer", "enum": [1] },
    "stepId": { "type": "string", "enum": ["impl-repair"] },
    "completionStatus": { "type": "string", "enum": ["done"] },
    "files": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "type": "object", "required": ["requirementId", "paths"], "properties": { "requirementId": { "type": "string", "minLength": 1 }, "paths": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "type": "string", "minLength": 1 } } }, "additionalProperties": false } },
    "issues": { "type": "array", "maxItems": 256, "items": { "type": "object", "required": ["classification", "reason", "remainingRisk"], "properties": { "classification": { "type": "string", "enum": ["quality"] }, "reason": { "type": "string", "minLength": 20 }, "remainingRisk": { "type": "string", "minLength": 20 } }, "additionalProperties": false } },
    "overview": { "type": "null" },
    "triage": { "type": "null" },
    "repair": { "type": "object", "required": ["version", "appliedFindingKeys", "summary"], "properties": { "version": { "type": "integer", "enum": [1] }, "appliedFindingKeys": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "type": "string", "minLength": 1 } }, "summary": { "type": "string", "minLength": 10 } }, "additionalProperties": false },
    "noChangeReason": { "type": "null" }
  },
  "additionalProperties": false
}
