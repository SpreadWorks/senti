prefix_rule(pattern=["senrail", "flow"], decision="allow")
prefix_rule(pattern=["senrail", "workflow"], decision="allow")
prefix_rule(pattern=["/bin/bash", "-lc", "senrail flow"], decision="allow")
prefix_rule(pattern=["node", "src/senrail.js"], decision="allow")
prefix_rule(pattern=["node", "tests/run.js"], decision="allow")
prefix_rule(pattern=["node", "--test"], decision="allow")
