prefix_rule(pattern=["sennel", "flow"], decision="allow")
prefix_rule(pattern=["sennel", "workflow"], decision="allow")
prefix_rule(pattern=["/bin/bash", "-lc", "sennel flow"], decision="allow")
prefix_rule(pattern=["node", "src/sennel.js"], decision="allow")
prefix_rule(pattern=["node", "tests/run.js"], decision="allow")
prefix_rule(pattern=["node", "--test"], decision="allow")
