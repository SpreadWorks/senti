prefix_rule(pattern=["senti", "flow"], decision="allow")
prefix_rule(pattern=["senti", "workflow"], decision="allow")
prefix_rule(pattern=["/bin/bash", "-lc", "senti flow"], decision="allow")
prefix_rule(pattern=["node", "src/senti.js"], decision="allow")
prefix_rule(pattern=["node", "tests/run.js"], decision="allow")
prefix_rule(pattern=["node", "--test"], decision="allow")
