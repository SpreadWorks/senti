{
  "name": "@spreadworks/senti",
  "version": "0.1.0-alpha.1859",
  "description": "Spec-Driven Development tooling for automated documentation generation",
  "repository": {
    "type": "git",
    "url": "https://github.com/SpreadWorks/senti.git"
  },
  "type": "module",
  "bin": {
    "senti": "./src/senti.js"
  },
  "exports": {
    ".": "./src/senti.js"
  },
  "files": [
    "src/",
    "!src/presets/*/tests/"
  ],
  "engines": {
    "node": ">=18.19.0"
  },
  "keywords": [
    "senti",
    "documentation",
    "spec-driven-development",
    "source-analysis",
    "technical-docs"
  ],
  "scripts": {
    "release:preflight": "node scripts/release-preflight.js",
    "release:version:sync": "node scripts/sync-alpha-version.js",
    "release:version:validate": "node scripts/validate-alpha-version.js",
    "test": "node tests/run.js",
    "test:unit": "node tests/run.js --scope unit",
    "test:e2e": "node tests/run.js --scope e2e",
    "test:acceptance": "node tests/acceptance/run.js",
    "test:agent": "node tests/run.js --agent",
    "test:all": "node tests/run.js --all",
    "test:ci": "node tests/ci.js"
  },
  "license": "MIT",
  "packageManager": "pnpm@11.13.1+sha512.b2fc7683b8a6525414e7d13e1ba28caaddde96bf66ec540bfaeb7e702b81f3e0be4d1f295edf7f9fe0396740a8dce4509c582ddf79891f4543fea32d37645f25"
}
