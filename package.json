{
  "name": "sdd-forge",
  "version": "0.1.0-alpha.1323",
  "description": "Spec-Driven Development tooling for automated documentation generation",
  "repository": {
    "type": "git",
    "url": "https://github.com/SpreadWorks/sdd-forge.git"
  },
  "type": "module",
  "bin": {
    "sdd-forge": "./src/sdd-forge.js"
  },
  "exports": {
    ".": "./src/sdd-forge.js"
  },
  "files": [
    "src/",
    "!src/presets/*/tests/"
  ],
  "engines": {
    "node": ">=18.19.0"
  },
  "keywords": [
    "sdd",
    "documentation",
    "spec-driven-development",
    "source-analysis",
    "technical-docs"
  ],
  "scripts": {
    "test": "node tests/run.js",
    "test:unit": "node tests/run.js --scope unit",
    "test:e2e": "node tests/run.js --scope e2e",
    "test:acceptance": "node tests/acceptance/run.js",
    "test:agent": "node tests/run.js --agent",
    "test:all": "node tests/run.js --all"
  },
  "license": "MIT",
  "packageManager": "pnpm@11.5.1+sha512.93f7b57422ea7068257235b4c16eb60762eb68e1dc23723199cc739043ea9be2c4143274a399d8c6defa2b1176226d9ca1c4b63482d6200c1a8fbaa78c1d1485"
}
