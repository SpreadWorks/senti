{
  "name": "sdd-forge",
  "version": "0.1.0-alpha.775",
  "description": "Spec-Driven Development tooling for automated documentation generation",
  "repository": {
    "type": "git",
    "url": "https://github.com/SpreadWorks/sdd-forge.git"
  },
  "type": "module",
  "bin": {
    "sdd-forge": "./src/sdd-forge.js"
  },
  "exports": {
    ".": "./src/sdd-forge.js"
  },
  "files": [
    "src/",
    "!src/presets/*/tests/"
  ],
  "engines": {
    "node": ">=18.19.0"
  },
  "keywords": [
    "sdd",
    "documentation",
    "spec-driven-development",
    "source-analysis",
    "technical-docs"
  ],
  "scripts": {
    "test": "node tests/run.js",
    "test:unit": "node tests/run.js --scope unit",
    "test:e2e": "node tests/run.js --scope e2e",
    "test:acceptance": "node tests/acceptance/run.js",
    "test:agent": "node tests/run.js --agent",
    "test:all": "node tests/run.js --all"
  },
  "license": "MIT",
  "packageManager": "pnpm@11.0.8+sha512.4c4097e1dd2d42372c4e7fa5a791ff28fc75a484c7ac192e64b1df0fdef17594ba982f9b4fed9adfb3c757846f565b799b2763fb3733d1de1bcb82cf46684912"
}
