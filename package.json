{
  "name": "sennel",
  "displayName": "Sennel",
  "version": "0.1.0-alpha.2004",
  "description": "Spec-Driven Development tooling for automated documentation generation",
  "repository": {
    "type": "git",
    "url": "https://github.com/SpreadWorks/sennel.git"
  },
  "type": "module",
  "bin": {
    "sennel": "./src/sennel.js"
  },
  "exports": {
    ".": "./src/sennel.js"
  },
  "files": [
    "src/",
    "!src/presets/*/tests/"
  ],
  "engines": {
    "node": ">=18.19.0"
  },
  "keywords": [
    "sennel",
    "documentation",
    "spec-driven-development",
    "source-analysis",
    "technical-docs"
  ],
  "scripts": {
    "release:preflight": "node scripts/release-preflight.js",
    "release:verify": "node scripts/verify-alpha-release.js",
    "release:pack": "node scripts/inspect-alpha-pack.js",
    "release:publish": "node scripts/publish-alpha-release.js",
    "release:promote": "node scripts/promote-alpha-release.js",
    "release:version:sync": "node scripts/sync-alpha-version.js",
    "release:version:validate": "node scripts/validate-alpha-version.js",
    "validate:skills": "node scripts/validate-skills.js",
    "test": "node tests/run.js",
    "test:unit": "node tests/run.js --scope unit",
    "test:integration": "node tests/run.js --scope integration",
    "test:e2e": "node tests/run.js --scope e2e",
    "test:acceptance": "node tests/run.js --scope acceptance",
    "test:agent": "node tests/run.js --scope agent",
    "test:all": "node tests/run.js --all"
  },
  "license": "MIT",
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000"
}
