{
  "name": "sdd-forge",
  "version": "0.1.0-alpha.775",
  "description": "Spec-Driven Development tooling for automated documentation generation",
  "repository": {
    "type": "git",
    "url": "https://github.com/SpreadWorks/sdd-forge.git"
  },
  "type": "module",
  "bin": {
    "sdd-forge": "./src/sdd-forge.js"
  },
  "exports": {
    ".": "./src/sdd-forge.js"
  },
  "files": [
    "src/",
    "!src/presets/*/tests/"
  ],
  "engines": {
    "node": ">=18.19.0"
  },
  "keywords": [
    "sdd",
    "documentation",
    "spec-driven-development",
    "source-analysis",
    "technical-docs"
  ],
  "scripts": {
    "test": "node tests/run.js",
    "test:unit": "node tests/run.js --scope unit",
    "test:e2e": "node tests/run.js --scope e2e",
    "test:acceptance": "node tests/acceptance/run.js",
    "test:agent": "node tests/run.js --agent",
    "test:all": "node tests/run.js --all"
  },
  "license": "MIT",
  "packageManager": "pnpm@11.0.9+sha512.34ce82e6780233cf9cad8685029a8f81d2e06196c5a9bad98879f7424940c6817c4e4524fb7d38b8553ceed48b9758b8ebaf1abd3600c232c4c8cf7366086f38"
}
