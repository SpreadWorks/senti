{
  "name": "senti",
  "logs": {
    "enabled": true
  },
  "lang": "ja",
  "type": [
    "node-cli",
    "greenfield",
    "document"
  ],
  "concurrency": 4,
  "docs": {
    "languages": [
      "ja",
      "en"
    ],
    "defaultLanguage": "en",
    "mode": "generate",
    "exclude": [
      "experimental/**",
      "src/presets/**"
    ],
    "style": {
      "purpose": "user-guide",
      "tone": "polite",
      "customInstruction": ""
    }
  },
  "chapters": [
    {
      "chapter": "overview.md",
      "desc": "senti の目的・設計思想・主要機能の概要"
    },
    {
      "chapter": "stack_and_ops.md",
      "desc": "Node.js ランタイム、外部依存なしポリシー、動作要件"
    },
    {
      "chapter": "project_structure.md",
      "desc": "src/ のディレクトリ構造、3層ディスパッチ、プリセットシステム"
    },
    {
      "chapter": "cli_commands.md",
      "desc": "docs/spec/flow サブコマンド群、オプション、使用例、終了コード"
    },
    {
      "chapter": "configuration.md",
      "desc": "config.json スキーマ、agent 設定、プリセット設定、flow 設定"
    },
    {
      "chapter": "internal_design.md",
      "desc": "テンプレートエンジン、DataSource、enrich パイプライン、言語ハンドラ"
    },
    {
      "chapter": "creating_presets.md",
      "desc": "プリセット作成ガイド。preset.json スキーマ、DataSource 実装、テンプレート継承、scan/data ペアリング規則、AI 向け実行チェックリスト"
    },
    {
      "chapter": "development_testing.md",
      "exclude": true
    }
  ],
  "scan": {
    "include": [
      "src/**/*.js",
      "src/**/*.mjs",
      "src/**/*.cjs",
      "package.json"
    ],
    "exclude": [
      "experimental/**"
    ]
  },
  "flow": {
    "merge": "squash"
  },
  "test": {
    "command": "node tests/run.js",
    "projectPaths": [
      "tests/unit/"
    ],
    "testExecuteRegression": "targeted"
  },
  "agent": {
    "default": "codex",
    "workDir": ".tmp",
    "timeout": 600,
    "retryCount": 2,
    "useProfile": "codex-only",
    "providers": {
      "claude/sonnet": {
        "command": "claude",
        "args": [
          "-p",
          "{{PROMPT}}",
          "--model",
          "sonnet",
          "--output-format",
          "json"
        ],
        "systemPromptFlag": "--system-prompt",
        "jsonOutputFlag": "--output-format json"
      },
      "claude/opus": {
        "command": "claude",
        "args": [
          "-p",
          "{{PROMPT}}",
          "--model",
          "opus",
          "--output-format",
          "json"
        ],
        "systemPromptFlag": "--system-prompt",
        "jsonOutputFlag": "--output-format json"
      },
      "claude/haiku": {
        "command": "claude",
        "args": [
          "-p",
          "{{PROMPT}}",
          "--model",
          "haiku",
          "--output-format",
          "json"
        ],
        "systemPromptFlag": "--system-prompt",
        "jsonOutputFlag": "--output-format json"
      },
      "codex/gpt-5.5": {
        "command": "codex",
        "args": [
          "exec",
          "--json",
          "--sandbox",
          "workspace-write",
          "-m",
          "gpt-5.5",
          "-C",
          ".tmp",
          "{{PROMPT}}"
        ],
        "jsonOutputFlag": "--json"
      },
      "codex/gpt-5.4": {
        "command": "codex",
        "args": [
          "exec",
          "--json",
          "--sandbox",
          "workspace-write",
          "-m",
          "gpt-5.4",
          "-C",
          ".tmp",
          "{{PROMPT}}"
        ],
        "jsonOutputFlag": "--json"
      },
      "codex/gpt-5.3": {
        "command": "codex",
        "args": [
          "exec",
          "--json",
          "--sandbox",
          "workspace-write",
          "-m",
          "gpt-5.3-codex",
          "-C",
          ".tmp",
          "{{PROMPT}}"
        ],
        "jsonOutputFlag": "--json"
      },
      "codex/gpt-5.4-mini": {
        "command": "codex",
        "args": [
          "exec",
          "--json",
          "--sandbox",
          "workspace-write",
          "-m",
          "gpt-5.4-mini",
          "-C",
          ".tmp",
          "{{PROMPT}}"
        ],
        "jsonOutputFlag": "--json"
      },
      "codex/gpt-5.3-spark": {
        "command": "codex",
        "args": [
          "exec",
          "--json",
          "--sandbox",
          "workspace-write",
          "-m",
          "gpt-5.3-codex-spark",
          "-C",
          ".tmp",
          "{{PROMPT}}"
        ],
        "jsonOutputFlag": "--json"
      }
    },
    "profiles": {
      "claude-main": {
        "docs.init": "claude/sonnet",
        "docs.enrich": "claude/sonnet",
        "docs.text": "claude/sonnet",
        "docs.forge": "claude/sonnet",
        "docs.readme": "claude/sonnet",
        "docs.agents": "claude/haiku",
        "docs.translate": "codex/gpt-5.4",
        "flow.auto-check": "claude/sonnet",
        "flow.spec.gate": "claude/sonnet",
        "flow.spec.review.propose": "codex/gpt-5.5",
        "flow.draft.review.questions.propose": "codex/gpt-5.5",
        "flow.draft.review.coverage.propose": "codex/gpt-5.5",
        "flow.impl.review.propose": "codex/gpt-5.5",
        "flow.impl.review.final": "claude/opus",
        "flow.test.execute": "claude/sonnet",
        "flow.test.result-review": "claude/haiku",
        "flow.test.review": "codex/gpt-5.5",
        "flow.finalize.retro": "claude/haiku",
        "flow.context.search": "claude/haiku"
      },
      "codex-main": {
        "docs.init": "claude/sonnet",
        "docs.enrich": "claude/sonnet",
        "docs.text": "claude/sonnet",
        "docs.forge": "claude/sonnet",
        "docs.readme": "codex/gpt-5.3-spark",
        "docs.agents": "codex/gpt-5.3-spark",
        "docs.translate": "codex/gpt-5.5",
        "flow.auto-check": "claude/sonnet",
        "flow.spec.gate": "codex/gpt-5.3-spark",
        "flow.spec.review.propose": "claude/opus",
        "flow.draft.review.questions.propose": "claude/opus",
        "flow.draft.review.coverage.propose": "claude/opus",
        "flow.impl.review.propose": "claude/opus",
        "flow.impl.review.final": "claude/opus",
        "flow.test.execute": "claude/sonnet",
        "flow.test.result-review": "codex/gpt-5.3-spark",
        "flow.test.review": "claude/opus",
        "flow.finalize.retro": "codex/gpt-5.3-spark",
        "flow.context.search": "codex/gpt-5.3-spark"
      },
      "claude-only": {
        "docs": "claude/sonnet",
        "docs.agents": "claude/haiku",
        "flow.auto-check": "claude/sonnet",
        "flow.spec.gate": "claude/sonnet",
        "flow.spec.review.propose": "claude/opus",
        "flow.draft.review.questions.propose": "claude/opus",
        "flow.draft.review.coverage.propose": "claude/opus",
        "flow.impl.review.propose": "claude/opus",
        "flow.impl.review.final": "claude/opus",
        "flow.test.execute": "claude/sonnet",
        "flow.test.result-review": "claude/haiku",
        "flow.test.review": "claude/opus",
        "flow.finalize.retro": "claude/haiku",
        "flow.context.search": "claude/haiku"
      },
      "codex-only": {
        "docs.init": "codex/gpt-5.4",
        "docs.enrich": "codex/gpt-5.4",
        "docs.text": "codex/gpt-5.4",
        "docs.forge": "codex/gpt-5.4",
        "docs.readme": "codex/gpt-5.3-spark",
        "docs.agents": "codex/gpt-5.3-spark",
        "docs.translate": "codex/gpt-5.4",
        "flow.auto-check": "codex/gpt-5.4",
        "flow.spec.gate": "codex/gpt-5.3-spark",
        "flow.spec.review.propose": "codex/gpt-5.5",
        "flow.draft.review.questions.propose": "codex/gpt-5.5",
        "flow.draft.review.coverage.propose": "codex/gpt-5.5",
        "flow.impl.review.propose": "codex/gpt-5.5",
        "flow.impl.review.final": "codex/gpt-5.5",
        "flow.test.execute": "codex/gpt-5.4",
        "flow.test.result-review": "codex/gpt-5.3-spark",
        "flow.test.review": "codex/gpt-5.5",
        "flow.finalize.retro": "codex/gpt-5.3-spark",
        "flow.context.search": "codex/gpt-5.3-spark"
      }
    }
  },
  "plugin": {
    "packages": [
      {
        "id": "official-presets",
        "commit": "31bdd70fecfcde33c32bd75909218b744561c24e",
        "source": "official-presets"
      }
    ],
    "config": {},
    "sources": [
      {
        "id": "official-presets",
        "type": "git",
        "url": "git@github.com:SpreadWorks/senti-presets.git"
      }
    ]
  }
}
