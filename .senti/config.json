{
  "name": "senti",
  "logs": {
    "enabled": true
  },
  "lang": "ja",
  "type": [
    "node-cli",
    "greenfield",
    "document"
  ],
  "concurrency": 4,
  "docs": {
    "languages": [
      "ja",
      "en"
    ],
    "defaultLanguage": "en",
    "mode": "generate",
    "exclude": [
      "experimental/**",
      "src/presets/**"
    ],
    "style": {
      "purpose": "user-guide",
      "tone": "polite",
      "customInstruction": ""
    }
  },
  "chapters": [
    {
      "chapter": "overview.md",
      "desc": "senti の目的・設計思想・主要機能の概要"
    },
    {
      "chapter": "stack_and_ops.md",
      "desc": "Node.js ランタイム、外部依存なしポリシー、動作要件"
    },
    {
      "chapter": "project_structure.md",
      "desc": "src/ のディレクトリ構造、3層ディスパッチ、プリセットシステム"
    },
    {
      "chapter": "cli_commands.md",
      "desc": "docs/spec/flow サブコマンド群、オプション、使用例、終了コード"
    },
    {
      "chapter": "configuration.md",
      "desc": "config.json スキーマ、agent 設定、プリセット設定、flow 設定"
    },
    {
      "chapter": "internal_design.md",
      "desc": "テンプレートエンジン、DataSource、enrich パイプライン、言語ハンドラ"
    },
    {
      "chapter": "creating_presets.md",
      "desc": "プリセット作成ガイド。preset.json スキーマ、DataSource 実装、テンプレート継承、scan/data ペアリング規則、AI 向け実行チェックリスト"
    },
    {
      "chapter": "development_testing.md",
      "exclude": true
    }
  ],
  "scan": {
    "include": [
      "src/**/*.js",
      "src/**/*.mjs",
      "src/**/*.cjs",
      "package.json"
    ],
    "exclude": [
      "experimental/**"
    ]
  },
  "flow": {
    "merge": "squash"
  },
  "test": {
    "command": "node tests/run.js",
    "projectPaths": [
      "tests/unit/"
    ],
    "testExecuteRegression": "targeted"
  },
  "agent": {
    "default": "codex",
    "workDir": ".tmp",
    "timeout": 600,
    "retryCount": 2,
    "useProfile": "codex-only",
    "providers": {
      "codex/gpt-5.3": {
        "command": "codex",
        "args": [
          "exec",
          "--json",
          "--sandbox",
          "workspace-write",
          "-m",
          "gpt-5.3-codex",
          "-C",
          ".tmp",
          "{{PROMPT}}"
        ],
        "jsonOutputFlag": "--json",
        "jsonSchemaFlag": "--output-schema",
        "jsonSchemaMode": "file"
      },
      "codex/gpt-5.4-mini": {
        "command": "codex",
        "args": [
          "exec",
          "--json",
          "--sandbox",
          "workspace-write",
          "-m",
          "gpt-5.4-mini",
          "-C",
          ".tmp",
          "{{PROMPT}}"
        ],
        "jsonOutputFlag": "--json",
        "jsonSchemaFlag": "--output-schema",
        "jsonSchemaMode": "file"
      }
    }
  },
  "plugin": {
    "packages": [
      {
        "id": "official-presets",
        "commit": "31bdd70fecfcde33c32bd75909218b744561c24e",
        "source": "official-presets"
      },
      {
        "id": "workflow",
        "commit": "45c6bacb25a4e266d09de8b5ab18c3379b018472",
        "source": "senti-workflow-plugin"
      }
    ],
    "config": {
      "workflow": {
        "flowIntegration": "enable",
        "agent": {
          "publish": {
            "provider": "codex/gpt-5.5"
          },
          "classify": {
            "provider": "codex/gpt-5.5"
          },
          "similarity": {
            "provider": "codex/gpt-5.5"
          },
          "compose": {
            "provider": "codex/gpt-5.5"
          }
        },
        "languages": {
          "source": "ja",
          "publish": "en"
        }
      }
    },
    "sources": [
      {
        "id": "official-presets",
        "type": "git",
        "url": "git@github.com:SpreadWorks/senti-presets.git"
      },
      {
        "id": "senti-workflow-plugin",
        "type": "git",
        "url": "git@github.com:SpreadWorks/senti-workflow-plugin.git"
      }
    ]
  }
}
