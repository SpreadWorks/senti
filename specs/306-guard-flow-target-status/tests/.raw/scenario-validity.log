      }
    
      async runFinalizeHook(handler, args) {
        const finalize = await import("./lib/run-finalize.js");
        if (handler === "prepareFinalizeMerge") {
          const metadataPreflight = finalize.readFinalizeMergeMetadataPreflight({
            root: this.ctx.root,
