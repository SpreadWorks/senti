    }
    
    class RegistryLifecycleAdapter {
      constructor(ctx, result, err) {
        this.ctx = ctx;
        this.result = result;
        this.err = err;
        this.phase = result?.artifacts?.phase || ctx.phase;
      }
    
      setStepStatus(step, status) {
        if (step.startsWith("finalize-")) {
