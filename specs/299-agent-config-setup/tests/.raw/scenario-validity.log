              const content = fs.readFileSync(claudePath, "utf8");
              fs.unlinkSync(claudePath);
              fs.writeFileSync(claudePath, content, "utf8");
            }
          } catch (err) { if (err.code !== "ENOENT") console.error(err); }
        }
        
