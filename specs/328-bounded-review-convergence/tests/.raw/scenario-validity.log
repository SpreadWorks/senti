        }
      }
      if (artifacts["impl-gate-result.json"]) {
        try {
          validateImplGateEvidence(artifacts["impl-gate-result.json"]);
        } catch (_) {
          invalidSchemas.push("impl-gate-result.json");
        }
      }
      if (artifacts["retro.json"]) {
