{
  "name": "sdd-forge",
  "logs": {
    "enabled": true
  },
  "experimental": {
    "workflow": {
      "enable": true,
      "languages": {
        "source": "ja",
        "publish": "en"
      }
    }
  },
  "lang": "ja",
  "type": [
    "node-cli",
    "greenfield",
    "document"
  ],
  "concurrency": 4,
  "docs": {
    "languages": [
      "ja",
      "en"
    ],
    "defaultLanguage": "en",
    "mode": "generate",
    "exclude": [
      "experimental/**",
      "src/presets/**"
    ],
    "style": {
      "purpose": "user-guide",
      "tone": "polite",
      "customInstruction": ""
    }
  },
  "chapters": [
    {
      "chapter": "overview.md",
      "desc": "sdd-forge の目的・設計思想・主要機能の概要"
    },
    {
      "chapter": "stack_and_ops.md",
      "desc": "Node.js ランタイム、外部依存なしポリシー、動作要件"
    },
    {
      "chapter": "project_structure.md",
      "desc": "src/ のディレクトリ構造、3層ディスパッチ、プリセットシステム"
    },
    {
      "chapter": "cli_commands.md",
      "desc": "docs/spec/flow サブコマンド群、オプション、使用例、終了コード"
    },
    {
      "chapter": "configuration.md",
      "desc": "config.json スキーマ、agent 設定、プリセット設定、flow 設定"
    },
    {
      "chapter": "internal_design.md",
      "desc": "テンプレートエンジン、DataSource、enrich パイプライン、言語ハンドラ"
    },
    {
      "chapter": "creating_presets.md",
      "desc": "プリセット作成ガイド。preset.json スキーマ、DataSource 実装、テンプレート継承、scan/data ペアリング規則、AI 向け実行チェックリスト"
    },
    {
      "chapter": "development_testing.md",
      "exclude": true
    }
  ],
  "scan": {
    "include": [
      "src/**/*.js",
      "src/**/*.mjs",
      "src/**/*.cjs",
      "package.json"
    ],
    "exclude": [
      "experimental/**"
    ]
  },
  "flow": {
    "merge": "squash"
  },
  "agent": {
    "default": "claude/sonnet",
    "workDir": ".tmp",
    "timeout": 600,
    "retryCount": 2,
    "useProfile": "default",
    "providers": {
      "claude/sonnet": {
        "command": "claude",
        "args": ["-p", "{{PROMPT}}", "--model", "sonnet", "--output-format", "json"],
        "systemPromptFlag": "--system-prompt",
        "jsonOutputFlag": "--output-format json"
      },
      "claude/opus": {
        "command": "claude",
        "args": ["-p", "{{PROMPT}}", "--model", "opus", "--output-format", "json"],
        "systemPromptFlag": "--system-prompt",
        "jsonOutputFlag": "--output-format json"
      },
      "codex/gpt-5.4": {
        "command": "codex",
        "args": ["exec", "--json", "--full-auto", "-m", "gpt-5.4", "-C", ".tmp", "{{PROMPT}}"],
        "jsonOutputFlag": "--json"
      },
      "codex/gpt-5.3": {
        "command": "codex",
        "args": ["exec", "--json", "--full-auto", "-m", "gpt-5.3-codex", "-C", ".tmp", "{{PROMPT}}"],
        "jsonOutputFlag": "--json"
      }
    },
    "profiles": {
      "default": {
        "docs.init":         "claude/sonnet",
        "docs.enrich":       "claude/opus",
        "docs.text":         "claude/opus",
        "docs.forge":        "claude/opus",
        "docs.readme":       "claude/sonnet",
        "docs.agents":       "claude/opus",
        "docs.translate":    "codex/gpt-5.4",
        "flow.spec.gate":         "claude/sonnet",
        "flow.spec.review":       "claude/sonnet",
        "flow.impl.review.draft": "codex/gpt-5.4",
        "flow.impl.review.final": "claude/opus",
        "flow.test.review":       "claude/sonnet",
        "flow.finalize.retro":    "claude/sonnet",
        "flow.context.search":    "claude/sonnet"
      },
      "codex": {
        "docs": "codex/gpt-5.3",
        "flow": "codex/gpt-5.3"
      }
    }
  }
}
